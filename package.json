{
  "name": "@wintermuted/ui-theme",
  "version": "0.21.2",
  "description": "Shared Wintermuted UI theme (design tokens, base resets, and component styles) derived from the CV styling language.",
  "type": "module",
  "main": "./index.js",
  "license": "MIT",
  "keywords": [
    "css",
    "design-system",
    "theme",
    "ui"
  ],
  "files": [
    "index.js",
    "index.css",
    "styles/**/*.css",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wintermuted/ui-theme.git"
  },
  "bugs": {
    "url": "https://github.com/wintermuted/ui-theme/issues"
  },
  "homepage": "https://github.com/wintermuted/ui-theme#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./index.css": "./index.css",
    "./styles/tokens.css": "./styles/tokens.css",
    "./styles/base.css": "./styles/base.css",
    "./styles/components.css": "./styles/components.css",
    "./styles/components/card.css": "./styles/components/card.css",
    "./styles/components/button.css": "./styles/components/button.css",
    "./styles/components/badge.css": "./styles/components/badge.css",
    "./styles/components/tag.css": "./styles/components/tag.css",
    "./styles/components/list.css": "./styles/components/list.css",
    "./styles/components/separator.css": "./styles/components/separator.css",
    "./styles/components/side-nav.css": "./styles/components/side-nav.css",
    "./styles/components/stat-card.css": "./styles/components/stat-card.css",
    "./styles/components/tab-bar.css": "./styles/components/tab-bar.css",
    "./styles/components/modal.css": "./styles/components/modal.css",
    "./styles/components/empty-state.css": "./styles/components/empty-state.css",
    "./styles/components/file-upload.css": "./styles/components/file-upload.css",
    "./styles/components/view-header.css": "./styles/components/view-header.css",
    "./styles/components/layout.css": "./styles/components/layout.css",
    "./styles/components/inline-panel.css": "./styles/components/inline-panel.css",
    "./styles/components/checkbox-filter.css": "./styles/components/checkbox-filter.css",
    "./styles/components/chart.css": "./styles/components/chart.css",
    "./styles/components/gallery.css": "./styles/components/gallery.css",
    "./styles/components/toggle.css": "./styles/components/toggle.css",
    "./styles/components/slider.css": "./styles/components/slider.css",
    "./styles/components/toggle-group.css": "./styles/components/toggle-group.css",
    "./styles/components/toast.css": "./styles/components/toast.css",
    "./styles/components/code-block.css": "./styles/components/code-block.css"
  },
  "scripts": {
    "showcase:serve": "python3 -m http.server 4174",
    "showcase:open": "sh -c 'command -v open >/dev/null 2>&1 && open http://localhost:4174/showcase/ || xdg-open http://localhost:4174/showcase/'",
    "showcase:open:sample-data": "sh -c 'command -v open >/dev/null 2>&1 && open http://localhost:4174/showcase/sample-data.html || xdg-open http://localhost:4174/showcase/sample-data.html'",
    "showcase:open:forms": "sh -c 'command -v open >/dev/null 2>&1 && open http://localhost:4174/showcase/forms.html || xdg-open http://localhost:4174/showcase/forms.html'",
    "showcase:view": "npm run showcase:serve",
    "link:local": "bash scripts/link-local.sh",
    "unlink:local": "bash scripts/unlink-local.sh",
    "lint": "stylelint \"styles/**/*.css\" \"index.css\""
  },
  "devDependencies": {
    "stylelint": "^17.10.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
